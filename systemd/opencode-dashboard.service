[Unit]
Description=OpenCode usage dashboard (read-only over opencode.db)
After=network.target

[Service]
Type=simple
User=derek
WorkingDirectory=/home/derek/projects/opencode-dashboard
ExecStart=/usr/bin/python3 -m opencode_deck.server --host 127.0.0.1 --port 8799
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
